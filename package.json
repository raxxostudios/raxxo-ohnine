{
  "name": "ohnine",
  "productName": "OhNine",
  "version": "1.0.8",
  "description": "Oh Nine. Oh Nein. The menu bar app that tells you how much Claude you have left before it tells you no.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "keywords": [
    "claude",
    "anthropic",
    "usage",
    "menubar",
    "tray"
  ],
  "author": {
    "name": "RAXXO Studios",
    "email": "help@raxxo.shop"
  },
  "homepage": "https://github.com/raxxostudios/raxxo-ohnine",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "studio.raxxo.ohnine",
    "productName": "OhNine",
    "icon": "assets/icon.icns",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "artifactName": "OhNine-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "OhNine",
      "background": "assets/dmg-bg.png",
      "icon": "assets/icon.icns",
      "iconSize": 80,
      "contents": [
        {
          "x": 135,
          "y": 200
        },
        {
          "x": 405,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "artifactName": "OhNine-Setup-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "OhNine-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.iconset",
      "category": "Utility",
      "artifactName": "OhNine-${version}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "OhNine",
          "Comment": "Claude usage monitor for your menu bar"
        }
      }
    },
    "deb": {
      "depends": [
        "libappindicator3-1",
        "libnotify4"
      ],
      "compression": "gz"
    },
    "files": [
      "main.js",
      "preload.js",
      "popup.html",
      "popup.css",
      "popup.js",
      "assets/**",
      "package.json"
    ]
  }
}
