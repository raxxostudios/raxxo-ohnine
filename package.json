{
  "name": "ohnine",
  "productName": "OhNine",
  "version": "1.0.1",
  "description": "Oh Nine. Oh Nein. The menu bar app that tells you how much Claude you have left before it tells you no.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "keywords": [
    "claude",
    "anthropic",
    "usage",
    "menubar",
    "tray"
  ],
  "author": "RAXXO Studios",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "studio.raxxo.ohnine",
    "productName": "OhNine",
    "icon": "assets/icon.icns",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "OhNine",
      "background": "assets/dmg-bg.png",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "popup.html",
      "popup.css",
      "popup.js",
      "assets/**",
      "package.json"
    ]
  }
}
